<div class="min-h-screen">
  <h1 class="text-white text-3xl font-semibold mb-6">Кошик</h1>
  <div id="errorContainer"></div>
  <div data-controller="cart">
    <div class="mt-4 font-medium text-white" id="total"></div>
    <button class="mt-6 py-2 px-4 bg-orange-600 hover:bg-orange-500 rounded text-white font-semibold focus:outline-none focus:ring-2 focus:ring-orange-500" data-action="click->cart#checkout">Підтвердити</button>
    <button class="ml-2 py-2 px-4 bg-orange-600 hover:bg-orange-500 rounded text-white font-semibold focus:outline-none focus:ring-2 focus:ring-orange-500" data-action="click->cart#clear">Очистити кошик</button>
  </div>
</div>
