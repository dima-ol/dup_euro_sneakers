<%- if controller_name != 'sessions' %>
  <%= link_to "Увійти", new_session_path(resource_name), class: "text-white underline hover:text-orange-300" %><br />
<% end %>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <%= link_to "Не отримали інструкції підтвердження?", new_confirmation_path(resource_name), class: "text-white underline hover:text-orange-300" %><br />
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <%= link_to "Не отримали інструкції розблокування?", new_unlock_path(resource_name), class: "text-white underline hover:text-orange-300" %><br />
<% end %>

<%- if devise_mapping.omniauthable? %>
  <%- resource_class.omniauth_providers.each do |provider| %>
    <%= button_to "Увійти через #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "inline-flex items-center justify-center rounded-lg bg-zinc-800 px-4 py-2 text-sm font-semibold text-white hover:bg-zinc-700 focus:outline-none focus:ring-2 focus:ring-orange-500" %><br />
  <% end %>
<% end %>
