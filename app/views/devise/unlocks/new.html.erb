<h2 class="text-white text-3xl font-semibold mb-6">Відправити повторні інструкції розблокування</h2>

<%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field mb-4">
    <%= f.label :email, "Електронна пошта", class: "text-white block mb-2" %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-md border border-zinc-700 bg-zinc-950 px-3 py-2 text-white placeholder:text-zinc-500 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500" %>
  </div>

  <div class="actions">
    <%= f.submit "Відправити інструкції розблокування", class: "inline-flex items-center justify-center rounded-lg bg-orange-600 px-5 py-2 text-sm font-semibold text-white hover:bg-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
