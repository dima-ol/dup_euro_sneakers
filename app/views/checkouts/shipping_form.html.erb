<div class="container mx-auto mt-28 max-w-2xl px-2 sm:px-6 lg:px-8">
  <h1 class="text-white text-3xl font-semibold mb-6">Інформація для доставки</h1>

  <% if flash[:error] %>
    <div class="rounded-lg border border-red-700 bg-red-950 p-4 text-white mb-6"><%= flash[:error] %></div>
  <% end %>

  <%= form_with model: @order, url: submit_shipping_checkouts_path, method: :post, local: true do |f| %>
    <div class="mb-4">
      <%= f.label :name, "Повне ім'я", class: "text-white block mb-2" %>
      <%= f.text_field :name, class: "w-full rounded-md border border-zinc-700 bg-zinc-950 px-3 py-2 text-white placeholder:text-zinc-500 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500", required: true %>
    </div>

    <div class="mb-4">
      <%= f.label :phone, "Номер телефону", class: "text-white block mb-2" %>
      <%= f.text_field :phone, class: "w-full rounded-md border border-zinc-700 bg-zinc-950 px-3 py-2 text-white placeholder:text-zinc-500 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500", required: true %>
    </div>

    <div class="mb-4">
      <%= f.label :email, "Email адреса", class: "text-white block mb-2" %>
      <%= f.email_field :email, class: "w-full rounded-md border border-zinc-700 bg-zinc-950 px-3 py-2 text-white placeholder:text-zinc-500 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500", required: true %>
    </div>

    <div class="mb-6">
      <%= f.label :address, "Адреса доставки", class: "text-white block mb-2" %>
      <%= f.text_area :address, class: "w-full rounded-md border border-zinc-700 bg-zinc-950 px-3 py-2 text-white placeholder:text-zinc-500 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500", required: true %>
    </div>

    <div>
      <%= f.submit "Оформити замовлення", class: "inline-flex items-center justify-center rounded-lg bg-orange-600 px-5 py-2 text-sm font-semibold text-white hover:bg-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500" %>
    </div>
  <% end %>
</div>
